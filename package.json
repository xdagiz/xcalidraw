{
  "name": "xcalidraw",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "fmt": "vp fmt",
    "lint": "vp lint --report-unused-disable-directives",
    "check": "vp check",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "vp run typecheck:node && vp run typecheck:web",
    "test": "vp test run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "vp run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && install-electron",
    "build:unpack": "vp run build && electron-builder --dir",
    "build:win": "vp run build && electron-builder --win",
    "build:mac": "vp run build && electron-builder --mac",
    "build:linux": "vp run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "0.10.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@12.3.1"
}
